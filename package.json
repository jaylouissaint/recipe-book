{
  "name": "recipe_book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:supabase": "bash scripts/setup-supabase.sh",
    "deploy:functions": "supabase functions deploy save-recipe --no-verify-jwt",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.mts",
    "check:setup": "bash scripts/check-setup.sh",
    "ios:project": "bash scripts/ios-secrets.sh && cd ios && xcodegen generate",
    "ios:sim": "bash scripts/ios-sim.sh",
    "ios:ipa": "bash scripts/build-ipa.sh",
    "ios:test": "bash scripts/ios-test.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
